# Copy this file to .env and replace every value before starting Docker.
FINANCE_SQL_SA_PASSWORD=replace-with-a-long-unique-development-password
FINANCE_JWT_KEY=replace-with-a-random-64-character-development-signing-key
FINANCE_SQL_PORT=1433
FINANCE_API_PORT=5180
FINANCE_FRONTEND_PORT=5173
FINANCE_SMTP_PORT=1025
FINANCE_MAILPIT_PORT=8025
FINANCE_FRONTEND_URL=http://localhost:5173
